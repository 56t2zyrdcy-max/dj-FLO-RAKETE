{
  "rules": {
    "platform": {
      ".read": "auth != null",
      ".write": false
    },

    "djs": {
      "$djId": {

        "ownerUid": {
          ".read": "auth != null",
          ".write": false
        },

        "requests": {
          ".read": "auth != null",
          ".write": false,

          "$reqId": {
            ".write": "auth != null && ((!data.exists() && newData.exists() && newData.child('uid').val() === auth.uid) || (data.exists() && newData.exists()) || (data.exists() && !newData.exists() && data.child('createdAt').val() < (now - 86400000)))",

            ".validate": "!data.exists() ? newData.hasChildren(['song','amount','tipStatus','createdAt','played']) : (newData.child('song').val() === data.child('song').val() && newData.child('createdAt').val() === data.child('createdAt').val() && newData.child('uid').val() === data.child('uid').val())",

            "song":          { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 160" },
            "amount":        { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000" },
            "tipStatus":     { ".validate": "newData.isString() && (newData.val() === 'paid' || newData.val() === 'none')" },
            "createdAt":     { ".validate": "newData.isNumber()" },
            "played":        { ".validate": "newData.isBoolean()" },
            "rejected":      { ".validate": "newData.isBoolean()" },
            "removed":       { ".validate": "newData.isBoolean()" },
            "reaction":      { ".validate": "newData.isString() && newData.val().length <= 8" },
            "uid":           { ".validate": "newData.isString()" },
            "paypalOrderId": { ".validate": "newData.isString() && newData.val().length <= 64" },
            "$other":        { ".validate": false }
          }
        },

        "guardrail": {
          ".read": "auth != null",
          "$bucket": {
            "$key": {
              ".write": "auth != null",
              ".validate": "!newData.exists() || newData.isNumber()"
            }
          }
        }
      }
    }
  }
}
