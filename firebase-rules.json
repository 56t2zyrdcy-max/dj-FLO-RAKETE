{
  "rules": {
    "platform": {
      ".read": "auth != null",
      ".write": false
    },

    "djs": {
      "$djId": {

        "ownerUid": {
          ".read": "auth != null",
          ".write": false
        },

        "requests": {
          ".read": "auth != null && (auth.token.firebase.sign_in_provider === 'anonymous' || auth.uid === root.child('djs').child($djId).child('ownerUid').val() || auth.uid === root.child('platform').child('ownerUid').val())",
          ".write": false,

          "$reqId": {
            ".write": "auth != null && ((!data.exists() && auth.token.firebase.sign_in_provider === 'anonymous' && newData.child('uid').val() === auth.uid) || auth.uid === root.child('djs').child($djId).child('ownerUid').val() || auth.uid === root.child('platform').child('ownerUid').val())",
            ".validate": "newData.hasChildren(['song','amount','tipStatus','createdAt','played']) || !newData.exists()",

            "song":          { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 160" },
            "amount":        { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000" },
            "tipStatus":     { ".validate": "newData.isString() && (newData.val() === 'paid' || newData.val() === 'none')" },
            "createdAt":     { ".validate": "newData.isNumber()" },
            "played":        { ".validate": "newData.isBoolean()" },
            "rejected":      { ".validate": "newData.isBoolean()" },
            "removed":       { ".validate": "newData.isBoolean()" },
            "reaction":      { ".validate": "newData.isString() && newData.val().length <= 8" },
            "uid":           { ".validate": "newData.isString()" },
            "paypalOrderId": { ".validate": "newData.isString() && newData.val().length <= 64" },
            "$other":        { ".validate": false }
          }
        },

        "guardrail": {
          ".read": "auth != null",
          "$bucket": {
            "$key": {
              ".write": "auth != null",
              ".validate": "!newData.exists() || newData.isNumber()"
            }
          }
        }
      }
    }
  }
}
